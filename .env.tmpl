# Copy to .env (git-ignored) and fill in. Loaded by Tilt and by direnv (.envrc).

# --- AWS ---
AWS_PROFILE=personal
AWS_REGION=us-east-1
MODEL_ID=us.amazon.nova-micro-v1:0

# --- AgentCore Identity (see docs/linkedin-setup.md) ---
LINKEDIN_PROVIDER_NAME=slack-agent-linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LOCAL_WORKLOAD_NAME=slack-agent-local

# --- Slack (see docs/slack-setup.md) ---
# true  = no Slack workspace needed; replies are logged (use scripts/send_test_event.py)
# false = talk to a real Slack dev app through ngrok
SLACK_DRY_RUN=true
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=local-dev-signing-secret

LOG_LEVEL=INFO
