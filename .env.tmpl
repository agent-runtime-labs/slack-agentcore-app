# Copy to .env (git-ignored) and fill in. Loaded by Tilt and by direnv (.envrc).

# --- AWS ---
AWS_PROFILE=personal
AWS_REGION=us-east-1
MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- AgentCore Identity (see docs/linkedin-setup.md) ---
LINKEDIN_PROVIDER_NAME=slack-agent-linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GITHUB_PROVIDER_NAME=slack-agent-github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LOCAL_WORKLOAD_NAME=slack-agent-local

# --- CIMD remote MCP servers (see docs/cimd-providers.md) ---
# No client ID or secret: the app identifies itself with the URL of its client metadata
# document. Locally the CIMD tools stay off until both of these are set, because consent
# needs a table to store tokens in and an https URL the provider can fetch.
#   CIMD_TOKEN_TABLE: name of a deployed <project>-<env>-cimd-tokens table
#   PUBLIC_BASE_URL : your ngrok https URL, so Linear/Notion can reach the document
CIMD_PROVIDERS=linear,notion
CIMD_TOKEN_TABLE=
# PUBLIC_BASE_URL=https://<your-ngrok-subdomain>.ngrok-free.app

# --- Slack (see docs/slack-setup.md) ---
# true  = no Slack workspace needed; replies are logged (use scripts/send_test_event.py)
# false = talk to a real Slack dev app through ngrok
SLACK_DRY_RUN=true
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=local-dev-signing-secret

LOG_LEVEL=INFO
